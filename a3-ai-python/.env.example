APP_NAME=a3-ai-python
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=18080
APP_DEBUG=true

POSTGRES_DSN=postgresql+asyncpg://your_pg_user:your_pg_password@your-pg-endpoint:5432/a3_ai
LOCAL_POSTGRES_DSN=postgresql+asyncpg://your_local_pg_user:your_local_pg_password@127.0.0.1:5432/a3_ai
REDIS_DSN=redis://your-redis-endpoint:6379/0
CELERY_BROKER_URL=redis://your-redis-endpoint:6379/1
CELERY_RESULT_BACKEND=redis://your-redis-endpoint:6379/2

MILVUS_ENABLED=true
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=a3_learning
MILVUS_DIMENSION=1024

MINIO_ENDPOINT=replace-me
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_SECURE=false
MINIO_BUCKET=replace-me
# 可选：浏览器/LLM 可访问的 URL 前缀（通常含 bucket 路径），如 http://127.0.0.1:19000/learning-assets
# MINIO_PUBLIC_BASE_URL=

# Preferred enterprise-style object storage config.
# In local development these can mirror MinIO; in deployment they can target OSS/COS/S3-compatible storage.
OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_ENDPOINT=replace-me
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_VIRTUAL_HOSTED_STYLE=false
OBJECT_STORAGE_BUCKET=replace-me
# OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_PRESIGN_DAYS=7

# Enable object-storage-backed delivery for course source files and generated previews.
RESOURCE_SOURCE_FILE_STORAGE_ENABLED=false
RESOURCE_SOURCE_FILE_PRESIGN_DAYS=7

JAVA_GATEWAY_BASE_URL=http://your-gateway-host:10010
JAVA_INTERNAL_TOKEN=replace-me

LLM_PROVIDER=xfyun
LLM_MODEL=mock-model
LLM_FAST_MODEL=qwen-turbo
LLM_API_KEY=replace-me
LLM_BASE_URL=https://example.com
LLM_TIMEOUT_SECONDS=30

# AI 导师短期记忆：达到窗口比例后压缩旧对话，保留最近完整轮次
TUTORING_MEMORY_MAX_TOKENS=3200
TUTORING_MEMORY_TRIGGER_RATIO=0.75
TUTORING_MEMORY_RECENT_TURNS=3
TUTORING_MEMORY_SUMMARY_MAX_TOKENS=600

EMBEDDING_PROVIDER=openai_compat
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=replace-me
EMBEDDING_BASE_URL=https://example.com
EMBEDDING_TIMEOUT_SECONDS=30

FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
