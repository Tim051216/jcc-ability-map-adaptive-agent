# Required for the first ECS demo release.
MYSQL_HOST=your-mysql-endpoint
MYSQL_PORT=3306
MYSQL_DATABASE=tj_learning
MYSQL_USERNAME=replace-me
MYSQL_PASSWORD=replace-me

REDIS_HOST=your-redis-endpoint
REDIS_PORT=6379
REDIS_DATABASE=0

# Optional in the first demo release. Leave defaults unless you deploy extra services.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Optional upstreams for richer Java integration.
USER_SERVICE_BASE_URL=http://a3-user-service:8082
COURSE_SERVICE_BASE_URL=http://a3-course-service:8086
