# Optional. Only needed if this frontend still uses Gemini during local debugging.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Local AI service base URL for the student web app.
VITE_AI_BASE_URL="http://127.0.0.1:18080/api/v1"

# Toggle frontend offline demo fallback.
# true or unset: when backend requests fail, pages may fall back to demo data.
# false: never use demo fallback; always surface the real backend error.
VITE_ENABLE_OFFLINE_DEMO="true"

# Optional frontend app URL for callbacks or self-links.
APP_URL="MY_APP_URL"
