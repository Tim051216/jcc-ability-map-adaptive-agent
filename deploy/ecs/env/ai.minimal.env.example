# Required for first ECS demo
POSTGRES_DSN=postgresql+asyncpg://your_pg_user:your_pg_password@your-pg-endpoint:5432/a3_ai
REDIS_DSN=redis://your-redis-endpoint:6379/0
CELERY_BROKER_URL=redis://your-redis-endpoint:6379/1
CELERY_RESULT_BACKEND=redis://your-redis-endpoint:6379/2

MINIO_ENDPOINT=oss-cn-shanghai.aliyuncs.com
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_SECURE=true
MINIO_BUCKET=replace-me

OBJECT_STORAGE_PROVIDER=oss
OBJECT_STORAGE_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
OBJECT_STORAGE_SECURE=true
OBJECT_STORAGE_REGION=cn-shanghai
OBJECT_STORAGE_VIRTUAL_HOSTED_STYLE=true
OBJECT_STORAGE_BUCKET=replace-me
RESOURCE_SOURCE_FILE_STORAGE_ENABLED=true

JAVA_GATEWAY_BASE_URL=http://a3-gateway:10010
JAVA_INTERNAL_TOKEN=replace-me

LLM_PROVIDER=openai_compat
LLM_MODEL=replace-me
LLM_API_KEY=replace-me
LLM_BASE_URL=replace-me

EMBEDDING_PROVIDER=openai_compat
EMBEDDING_MODEL=replace-me
EMBEDDING_API_KEY=replace-me
EMBEDDING_BASE_URL=replace-me

MILVUS_ENABLED=false
