{
  "name": "a3-student-react-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3002 --host=0.0.0.0",
    "build": "vite build",
    "build:analyze": "powershell -NoProfile -Command \"$env:ANALYZE='true'; vite build --emptyOutDir=false\"",
    "preview": "vite preview",
    "helper:screenshot": "node ./scripts/local-screenshot-helper.mjs",
    "smoke:ai-closed-loop": "tsx ./scripts/smoke-ai-closed-loop.ts",
    "smoke:ai-tutor": "npm run smoke:ai-tutor-upload && npm run smoke:ai-tutor-multiformat && npm run smoke:ai-tutor-capture",
    "smoke:ai-tutor-generation-modes": "tsx ./scripts/smoke-ai-tutor-generation-modes.ts",
    "smoke:ai-tutor-capture": "tsx ./scripts/smoke-ai-tutor-capture.ts",
    "smoke:ai-tutor-upload": "tsx ./scripts/smoke-ai-tutor-upload.ts",
    "smoke:ai-tutor-multiformat": "tsx ./scripts/smoke-ai-tutor-multiformat.ts",
    "smoke:login": "tsx ./scripts/smoke-login.ts",
    "smoke:personalized-learning": "tsx ./scripts/smoke-personalized-learning.ts",
    "smoke:xa-competition": "tsx ./scripts/smoke-xa-competition.ts",
    "smoke:ai-annotation-agent": "tsx ./scripts/smoke-ai-annotation-agent.ts",
    "smoke:resource-center": "tsx ./scripts/smoke-resource-center.ts",
    "smoke:im-realtime": "tsx ./scripts/smoke-im-realtime.ts",
    "smoke:resource-learn": "tsx ./scripts/smoke-resource-learn.ts",
    "smoke:resource-preview": "tsx ./scripts/smoke-resource-preview.ts",
    "smoke:resources": "tsx ./scripts/smoke-resources.ts",
    "smoke:defense-core": "npm run smoke:resources && npm run smoke:personalized-learning && npm run smoke:im-realtime",
    "clean": "powershell -NoProfile -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }; if (Test-Path server.js) { Remove-Item -Force server.js }\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.185.0",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "echarts": "^6.1.0",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "jsmind": "^0.8.7",
    "katex": "^0.17.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nprogress": "^0.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
