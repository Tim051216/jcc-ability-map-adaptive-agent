APP_NAME=a3-ai-python
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=18080
APP_DEBUG=true

POSTGRES_DSN=postgresql+asyncpg://a3_ai:a3_ai_123@127.0.0.1:15432/a3_ai
REDIS_DSN=redis://127.0.0.1:16379/0
CELERY_BROKER_URL=redis://127.0.0.1:16379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/2

MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=a3_learning
MILVUS_DIMENSION=1024

MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=learning-assets
# 可选：浏览器/LLM 可访问的 URL 前缀（通常含 bucket 路径），如 http://127.0.0.1:19000/learning-assets
# MINIO_PUBLIC_BASE_URL=

JAVA_GATEWAY_BASE_URL=http://127.0.0.1:10010
JAVA_INTERNAL_TOKEN=replace-me

LLM_PROVIDER=xfyun
LLM_MODEL=mock-model
LLM_API_KEY=replace-me
LLM_BASE_URL=https://example.com
LLM_TIMEOUT_SECONDS=30

EMBEDDING_PROVIDER=openai_compat
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=replace-me
EMBEDDING_BASE_URL=https://example.com
EMBEDDING_TIMEOUT_SECONDS=30
