APP_NAME=a3-ai-python
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=18080
APP_DEBUG=true

# Local Docker services from docker-compose.local.yml.
POSTGRES_DSN=postgresql+asyncpg://a3_ai:a3_ai_123@127.0.0.1:15432/a3_ai
LOCAL_POSTGRES_DSN=postgresql+asyncpg://a3_ai:a3_ai_123@127.0.0.1:15432/a3_ai
LOCAL_DEMO_SQLITE_ONLY=true
REDIS_DSN=redis://127.0.0.1:16379/0
CELERY_BROKER_URL=redis://127.0.0.1:16379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/2

MILVUS_ENABLED=true
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=a3_learning
MILVUS_DIMENSION=1024

MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=learning-assets
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:19000/learning-assets

OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_ENDPOINT=127.0.0.1:19000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_BUCKET=learning-assets
OBJECT_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:19000/learning-assets
OBJECT_STORAGE_PRESIGN_DAYS=7
RESOURCE_SOURCE_FILE_STORAGE_ENABLED=false
RESOURCE_SOURCE_FILE_PRESIGN_DAYS=7

JAVA_GATEWAY_BASE_URL=http://127.0.0.1:10010
JAVA_INTERNAL_TOKEN=local-development-token

# The app starts without a paid model and uses its built-in fallback paths.
# Replace these values in .env to enable your team's real model provider.
LLM_PROVIDER=openai_compat
LLM_MODEL=qwen-turbo
LLM_FAST_MODEL=qwen-turbo
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:9/v1
LLM_TIMEOUT_SECONDS=3

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=local-hash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT_SECONDS=3

TUTORING_MEMORY_MAX_TOKENS=3200
TUTORING_MEMORY_TRIGGER_RATIO=0.75
TUTORING_MEMORY_RECENT_TURNS=3
TUTORING_MEMORY_SUMMARY_MAX_TOKENS=600

FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
